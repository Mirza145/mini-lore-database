# Server
PORT=5000
# Bind to loopback only. Do not expose unauthenticated write endpoints publicly.
HOST=127.0.0.1
NODE_ENV=development

# Database
# Set USE_MEMORY_DB=true to run entirely without installing MongoDB.
# The data is a real MongoDB database, persisted under server/.mongo-data.
USE_MEMORY_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017/mini-lore-database

# In-memory database options (ignored when USE_MEMORY_DB=false)
MEMORY_DB_PERSIST=true
MEMORY_DB_DIR=.mongo-data
# Optional: pin the MongoDB binary version downloaded by mongodb-memory-server
# MONGOMS_VERSION=8.2.6

# Seed the sample One Piece universe automatically when the database is empty
AUTO_SEED=true

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
